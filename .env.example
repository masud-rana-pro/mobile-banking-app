# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/smartkash_db
DATABASE_USERNAME=smartkash_admin
DATABASE_PASSWORD=replace-with-your-local-database-password

# Application security
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MINUTES=60

# Firebase Admin SDK (backend)
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-your-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-your-service-account-private-key
FIREBASE_PRIVATE_KEY_ID=replace-with-your-private-key-id
FIREBASE_CLIENT_ID=replace-with-your-client-id

# Firebase client configuration (Flutter Android)
FIREBASE_ENABLED=true
FIREBASE_ANDROID_API_KEY=replace-with-your-android-api-key
FIREBASE_ANDROID_APP_ID=replace-with-your-android-app-id
FIREBASE_MESSAGING_SENDER_ID=replace-with-your-messaging-sender-id

# Runtime
FCM_ENABLED=false
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
PROFILE_IMAGE_STORAGE_DIR=src/main/resources/profile-images
